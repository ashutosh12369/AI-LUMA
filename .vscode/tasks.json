{
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
    },
    "tasks": [
        {
            "label": "Start Redis",
            "type": "shell",
            "command": "docker-compose up -d",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "Start Gateway",
            "type": "shell",
            "command": "npm install ; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/backend/gateway"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "Start Auth Service",
            "type": "shell",
            "command": "npm install ; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/backend/services/auth"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "Start Agent Service",
            "type": "shell",
            "command": "npm install ; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/backend/services/agent"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "Start Billing Service",
            "type": "shell",
            "command": "npm install ; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/backend/services/billing"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "Start Chat Service",
            "type": "shell",
            "command": "npm install ; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/backend/services/chat"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "npm install ; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "group": "ai-luma"
            }
        },
        {
            "label": "🚀 Run AI-LUMA Project",
            "dependsOn": [
                "Start Redis",
                "Start Gateway",
                "Start Auth Service",
                "Start Agent Service",
                "Start Billing Service",
                "Start Chat Service",
                "Start Frontend"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
